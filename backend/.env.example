# Copiar este archivo a ".env" y completar con los valores reales de producción.
# NUNCA subir el archivo ".env" (con los valores reales) a repositorios públicos.

# Conexión a PostgreSQL. Formato: postgresql://usuario:password@host:5432/nombre_db
DATABASE_URL=postgresql://milanesas_user:CAMBIAR_PASSWORD@localhost:5432/milanesas_db

# Clave secreta para firmar los tokens de login. Generarla con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLAVE_SECRETA=CAMBIAR_POR_UNA_CLAVE_GENERADA_ALEATORIA

# Dominio(s) desde donde se va a acceder al frontend, separados por coma.
# Ejemplo: https://stock.pertutti.com.ar
ORIGENES_PERMITIDOS=https://stock.pertutti.com.ar
